# Settings shared by scripts/*.sh  (sourced by bash - no spaces around '=').
# Every value can be overridden per run from the environment, e.g.
#     YARN_QUEUE=default REDUCERS=2 scripts/run_nightly.sh 2019-10-01

# --- Hadoop client binaries (use full paths if they are not on PATH, e.g. under cron)
HADOOP_BIN="${HADOOP_BIN:-hadoop}"
HDFS_BIN="${HDFS_BIN:-hdfs}"

# --- HDFS layout
#   raw logs  : $HDFS_RAW_DIR/dt=YYYY-MM-DD/*.csv        (one partition per day)
#   job output: $HDFS_OUT_DIR/dt=YYYY-MM-DD/{peak_hour,top_pages,error_rate,...}
HDFS_RAW_DIR="${HDFS_RAW_DIR:-/clickstream/raw}"
HDFS_OUT_DIR="${HDFS_OUT_DIR:-/clickstream/out}"
HDFS_BLOCK_SIZE="${HDFS_BLOCK_SIZE:-134217728}"   # 128 MB blocks -> one map task per 128 MB of log
HDFS_REPLICATION="${HDFS_REPLICATION:-1}"         # 1 for a single-node lab (pseudo-distributed); 3 on a real cluster

# --- where a day's exported CSV files are dropped by the web/app side
LANDING_DIR="${LANDING_DIR:-/data/clickstream/landing}"

# --- YARN
YARN_QUEUE="${YARN_QUEUE:-batch}"     # see config/capacity-scheduler-batch-queue.xml
REDUCERS="${REDUCERS:-8}"             # reducers for the big "count per product" stage

# --- Reports
TOP_N="${TOP_N:-10}"
JAR="${JAR:-target/clickstream-mr.jar}"
REPORT_DIR="${REPORT_DIR:-reports}"   # relative to the project root
